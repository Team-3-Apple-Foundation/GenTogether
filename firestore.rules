rules_version = '2';

// GenTogether Firestore security rules.
//
// Structure documented in FIREBASE_SETUP.md. Key principles:
//   1. Public learning content (tutorialSteps, challenges, questions,
//      communityQuestions) is read-only for signed-in clients; only the
//      Firebase Console / Admin SDK / FirebaseSeeder (dev only, run
//      through the Admin-privileged environment, not the app) may write it.
//   2. Every user (guest or registered) may read/write only their own
//      users/{userId} document and its subcollections.
//   3. Community posts/comments may only be created, edited, or deleted by
//      their owner (userId == request.auth.uid), ownership fields can't be
//      changed after creation, and content must be a non-empty, bounded
//      string.
//   4. Everything not explicitly allowed is denied.
//   5. Anonymous (guest) accounts get full read/write access everywhere
//      isSignedIn() is used above — guests are a first-class account type,
//      not a second-class one. The one deliberate exception is comment
//      likes: liking a comment requires a non-anonymous (registered)
//      account, enforced via isNonAnonymous() below, which checks
//      request.auth.token.firebase.sign_in_provider. Reading like data
//      stays open to guests like everything else.
//   6. Nested match rules (e.g. communityPosts/{postId}/comments/{commentId})
//      only apply when a document is reached via that literal path — they
//      do NOT extend to a collectionGroup() query across every post's
//      comments at once. That needs its own {path=**} wildcard rule (see
//      below), used by account deletion to find everything one user has
//      ever commented, scoped to their own comments only.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // True only for a permanent (email/password or Google) account — false
    // for Firebase Anonymous Auth sessions. Used to gate the one action
    // guests can't take: liking a comment.
    function isNonAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidContent(content) {
      return content is string
        && content.size() > 0
        && content.size() <= 1000;
    }

    // ---- Per-user data ----
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /preferences/{preferenceId} {
        allow read, write: if isOwner(userId);
      }

      match /challengeProgress/{challengeId} {
        allow read, write: if isOwner(userId);
      }

      match /gameSessions/{sessionId} {
        allow read, write: if isOwner(userId);

        match /answers/{answerId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // ---- Public learning content: read-only for signed-in clients ----
    match /tutorialSteps/{stepId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ---- Community ----
    match /communityQuestions/{questionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /communityPosts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidContent(request.resource.data.content);

      // TEMPORARY DIAGNOSTIC — deliberately stripped to the bare minimum
      // to isolate whether the update denial is coming from this rule's
      // field-comparison conditions at all, versus something else
      // entirely (wrong project, a conflicting rule, App/Console pointing
      // at different databases). Conditions are commented below, ready to
      // restore one at a time once we know which one(s), if any, are the
      // actual cause. DO NOT leave this deployed long-term — it removes
      // the ownership-field/content-tamper protections.
      allow update: if isSignedIn();
      // allow update: if isSignedIn()
      //   && resource.data.userId == request.auth.uid
      //   && request.resource.data.userId == resource.data.userId
      //   && request.resource.data.communityQuestionId == resource.data.communityQuestionId
      //   && request.resource.data.createdAt == resource.data.createdAt
      //   && (request.resource.data.content == resource.data.content
      //       || isValidContent(request.resource.data.content));

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && isValidContent(request.resource.data.content);

        // TEMPORARY DIAGNOSTIC — same reasoning as the post rule above:
        // stripped to bare minimum to isolate whether the field
        // conditions themselves are the cause. DO NOT leave deployed
        // long-term.
        allow update: if isSignedIn();
        // allow update: if isSignedIn()
        //   && resource.data.userId == request.auth.uid
        //   && request.resource.data.userId == resource.data.userId
        //   && request.resource.data.createdAt == resource.data.createdAt
        //   && (request.resource.data.content == resource.data.content
        //       || isValidContent(request.resource.data.content));

        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

        // ---- Comment likes ----
        // One doc per liking user, keyed by that user's own UID, so a user
        // can only ever create/delete their own like (never someone else's)
        // and can't like the same comment twice. Reading like data is open
        // to any signed-in user, including guests, so guests can still see
        // like counts — only the write action requires a registered account.
        match /likes/{likeUserId} {
          allow read: if isSignedIn();
          allow create, delete: if isNonAnonymous() && request.auth.uid == likeUserId;
          allow update: if false;
        }
      }
    }

    // ---- Collection-group read access for comments ----
    // The nested `allow read` under communityPosts/{postId}/comments/{commentId}
    // above only applies when a comment is reached via that literal path (a
    // post's own comment listener). It does NOT automatically extend to a
    // `collectionGroup("comments")` query, which searches every post's
    // comments subcollection at once — Firestore requires a separate rule
    // using the `{path=**}` wildcard for that. Account deletion needs
    // exactly this: finding every comment a user has ever left, across all
    // posts, so it can be reassigned to "[deleted user]". Scoped to only
    // the requester's own comments (never someone else's) — Firestore can
    // verify this against the query's own `userId == request.auth.uid`
    // filter without needing to enumerate every post first, per
    // https://firebase.google.com/docs/firestore/security/rules-query.
    // No update rule needed here: once the query returns real document
    // references, writes to them are evaluated against their actual
    // literal path, which is already covered by the nested `allow update`
    // rule above.
    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // ---- Default deny for anything not explicitly matched above ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
